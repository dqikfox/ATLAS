# ─────────────────────────────────────────────────────────────────────────────
# ATLAS environment configuration
# Copy this file to .env and fill in the values for your setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── Model provider ────────────────────────────────────────────────────────────
# Set to "openai" (default) or "ollama"
ATLAS_MODEL_PROVIDER=openai

# ── OpenAI settings (used when ATLAS_MODEL_PROVIDER=openai) ──────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0

# ── Ollama settings (used when ATLAS_MODEL_PROVIDER=ollama) ──────────────────
# Make sure the Ollama server is running before starting ATLAS.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── MCP server settings ───────────────────────────────────────────────────────
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765

# ── PyAutoGUI safety ─────────────────────────────────────────────────────────
# Seconds of pause injected between each automated GUI action (0 to disable)
PYAUTOGUI_PAUSE=0.5
# When "true" the agent will ask for confirmation before destructive actions
ATLAS_SAFE_MODE=true
